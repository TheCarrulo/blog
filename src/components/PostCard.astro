---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const dateStr = new Date(post.data.pubDate).toLocaleDateString('pt-PT', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li>
  <p class="post-card-date">
    <time datetime={new Date(post.data.pubDate).toISOString()}>{dateStr}</time>
  </p>
  <h2 class="post-card-title">
    <a href={`${base}posts/${post.slug}/`}>{post.data.title}</a>
  </h2>
  <p class="post-card-desc">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map((tag) => (
          <a href={`${base}tags/${tag}/`} class="tag">
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</li>
