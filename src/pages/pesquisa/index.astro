---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Pesquisa">
  <link slot="head" rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
  <h1 class="page-title">Pesquisa</h1>
  <div id="search"></div>
</BaseLayout>

<script define:vars={{ base }}>
  window.addEventListener('DOMContentLoaded', async () => {
    try {
      const { PagefindUI } = await import(`${base}pagefind/pagefind-ui.js`);
      new PagefindUI({
        element: '#search',
        baseUrl: base,
        showSubResults: true,
        translations: {
          placeholder: 'Pesquisar...',
          zero_results: 'Sem resultados para "[SEARCH_TERM]".',
          many_results: '[COUNT] resultados para "[SEARCH_TERM]"',
          one_result: '1 resultado para "[SEARCH_TERM]"',
        },
      });
    } catch {
      const el = document.getElementById('search');
      if (el)
        el.innerHTML =
          '<p class="search-notice">Pesquisa não disponível em modo de desenvolvimento. Faz <code>npm run build</code> primeiro.</p>';
    }
  });
</script>
